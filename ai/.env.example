SILKI_AI_ENVIRONMENT=local
SILKI_AI_LOG_LEVEL=INFO

# Spring-issued AI access token verification (P1)
# Use a PEM string; escaped \n sequences are restored by Settings.
SILKI_AI_JWT_PUBLIC_KEY=
SILKI_AI_JWT_ALGORITHMS='["RS256"]'
SILKI_AI_JWT_AUDIENCE=ai-ws
# Set only when Spring includes and enforces an issuer claim.
SILKI_AI_JWT_ISSUER=silki-be
SILKI_AI_SESSION_START_TIMEOUT_SECONDS=3
SILKI_AI_WEBSOCKET_IDLE_TIMEOUT_SECONDS=120

# CLOVA Speech streaming gRPC
SILKI_AI_CLOVA_GRPC_TARGET=clovaspeech-gw.ncloud.com:50051
SILKI_AI_CLOVA_SECRET_KEY=
SILKI_AI_CLOVA_LANGUAGE=ko
SILKI_AI_CLOVA_SEMANTIC_EPD=true
SILKI_AI_CLOVA_FLUSH_TIMEOUT_SECONDS=2
# true이면 서버 요청에 키워드를 직접 싣고 콘솔/도메인 부스팅은 사용하지 않습니다.
SILKI_AI_CLOVA_KEYWORD_BOOSTING_ENABLED=true
SILKI_AI_CLOVA_KEYWORD_WEIGHT=5
# 비워 두면 silki_ai/resources/clova_keywords.txt를 사용합니다.
SILKI_AI_CLOVA_KEYWORD_FILE=

# FastAPI Turn Manager
SILKI_AI_TURN_SILENCE_SECONDS=1.5
SILKI_AI_TURN_INCOMPLETE_SILENCE_SECONDS=2.5
SILKI_AI_VAD_AGGRESSIVENESS=2
SILKI_AI_AUDIO_FRAME_DURATION_MS=20

# Gemini query refinement
SILKI_AI_GEMINI_API_KEY=
SILKI_AI_GEMINI_MODEL=gemini-3.5-flash-lite
SILKI_AI_GEMINI_TIMEOUT_SECONDS=3

# Embedding and pgvector
SILKI_AI_DATABASE_URL=postgresql://silki:silki@localhost:5432/silki
SILKI_AI_MENU_SOURCE_TABLE=public.ai_menu_source
SILKI_AI_EMBEDDING_TABLE=ai.menu_embeddings
SILKI_AI_REINDEX_STATE_TABLE=ai.reindex_state
SILKI_AI_EMBEDDING_MODEL_NAME=jhgan/ko-sroberta-multitask
SILKI_AI_EMBEDDING_DIMENSION=768
SILKI_AI_EMBEDDING_PRELOAD=false
SILKI_AI_SEARCH_TOP_K=3
SILKI_AI_SEARCH_SCORE_THRESHOLD=0.45
SILKI_AI_AUTO_CREATE_SCHEMA=true

# Spring -> AI internal API
SILKI_AI_INTERNAL_API_KEY=
