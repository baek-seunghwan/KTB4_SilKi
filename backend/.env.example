SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/silko
SPRING_DATASOURCE_USERNAME=silko
SPRING_DATASOURCE_PASSWORD=silko

APP_ADMIN_EMAIL=admin@test.com
APP_ADMIN_PASSWORD=test1234
APP_ADMIN_NAME=테스트 관리자
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
REMEMBER_ME_KEY=replace-with-a-long-random-secret
REMEMBER_ME_VALIDITY_SECONDS=1209600

AI_BASE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=
AI_REINDEX_ENABLED=false
AI_CONNECT_TIMEOUT=1s
AI_REINDEX_REQUEST_TIMEOUT=3s

# PKCS#8 RSA private key. Inject it from a secret store; escaped \n is accepted.
AI_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_BASE64_PKCS8_PRIVATE_KEY\n-----END PRIVATE KEY-----"
AI_JWT_ISSUER=silki-be
AI_JWT_AUDIENCE=ai-ws
AI_JWT_TTL=2m

STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./data/uploads
IMAGE_PUBLIC_BASE_URL=http://localhost:8080/uploads/

SERVER_SERVLET_SESSION_COOKIE_SECURE=false
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
